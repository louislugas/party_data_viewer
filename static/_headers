# Netlify custom headers (copied to the site root by the static adapter).
# Hashed build assets never change under the same name, so cache them forever.
# Everything else (index.html, data/app-data.json) keeps Netlify's default
# "revalidate every time" caching, so a new deploy shows up immediately.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable
